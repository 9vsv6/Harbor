<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV's launcher banner (320 x 180): Harbor's mark on Harbor's dark canvas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp" android:height="180dp">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF111215" />
        </shape>
    </item>
    <item android:drawable="@drawable/harbor_mark" android:gravity="center"
        android:width="112dp" android:height="103dp" />
</layer-list>
