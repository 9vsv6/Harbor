<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window before the first frame. -->
    <style name="Theme.Harbor" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- The player: drawn under the camera cutout too (values-v28), so no black bar beside the picture. -->
    <style name="Theme.Harbor.Player" parent="Theme.Harbor" />
</resources>
